      "platforms": ["macos"],
      "status": {
        "macos": "required"
      },
      "notes": "Requires macOS 13+ and Metal 3 capable Apple silicon or supported AMD GPU on Intel Macs."
    }
  },
  "binary_candidates": [
    "{repo_root}/../goo.bin",
