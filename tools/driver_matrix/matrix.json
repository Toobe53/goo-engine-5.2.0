  "test_sets": {
    "smoke-opengl": {
      "description": "Launch headless, create an OpenGL GPU context and dump GPU/backend identity. Fails if the expected backend is not active.",
      "backend": "opengl",
      "timeout_sec": 600,
      "required": true,
      "commands": [
        [
          "{goo_binary}",
          "--background",
          "--factory-startup",
          "--gpu-backend",
          "{backend}",
          "--python-exit-code",
          "1",
          "--python",
          "{repo_root}/tools/driver_matrix/smoke/gpu_probe.py",
          "--",
          "--expect-backend",
          "{backend}",
          "--json-out",
          "{out_dir}/probe-{entry_id}-{backend}.json"
        ]
      ]
    },
    "smoke-vulkan": {
      "description": "Launch headless, create a Vulkan GPU context and dump GPU/backend identity. Fails if Vulkan falls back to another backend.",
      "backend": "vulkan",
      "timeout_sec": 600,
      "required": true,
      "commands": [
        [
          "{goo_binary}",
          "--background",
          "--factory-startup",
          "--gpu-backend",
          "{backend}",
          "--python-exit-code",
          "1",
          "--python",
          "{repo_root}/tools/driver_matrix/smoke/gpu_probe.py",
          "--",
          "--expect-backend",
          "{backend}",
          "--json-out",
          "{out_dir}/probe-{entry_id}-{backend}.json"
        ]
      ]
    },
    "smoke-metal": {
      "description": "Launch headless, create a Metal GPU context and dump GPU/backend identity. Fails if Metal is unavailable.",
      "backend": "metal",
      "timeout_sec": 600,
      "required": true,
      "commands": [
        [
          "{goo_binary}",
          "--background",
          "--factory-startup",
          "--gpu-backend",
          "{backend}",
          "--python-exit-code",
          "1",
          "--python",
          "{repo_root}/tools/driver_matrix/smoke/gpu_probe.py",
          "--",
          "--expect-backend",
          "{backend}",
          "--json-out",
          "{out_dir}/probe-{entry_id}-{backend}.json"
        ]
      ]
    },
    "render-eevee": {
      "description": "Render frame 1 of the factory startup scene with EEVEE on the selected backend and require a non-empty PNG. This exercises real GPU rendering rather than only context creation.",
      "per_backend": true,
      "timeout_sec": 900,
      "required": false,
      "commands": [
        [
          "{goo_binary}",
          "--background",
          "--factory-startup",
          "--gpu-backend",
          "{backend}",
          "-o",
          "{out_dir}/render_{entry_id}_{backend}_",
          "-F",
          "PNG",
          "-f",
          "1"
        ]
      ],
      "artifacts": [
        "{out_dir}/render_{entry_id}_{backend}_*.png"
      ]
    }
  },
