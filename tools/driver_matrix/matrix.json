  "policy": {
    "description": "Target validation matrix for Goo Engine 5.2. This file is a specification plus runner-selection metadata; it does NOT claim that every row has been executed. Rows marked required block a release only after they have actually run on the listed hardware.",
    "tiers": {
      "gate": "Must pass before a production release is published (every release candidate).",
      "nightly": "Runs on the nightly schedule; failures are triaged but do not block a release by themselves.",
      "advisory": "Best-effort coverage for deprecated or low-share configurations; failures are recorded, not gating."
    },
    "required_semantics": "required=true means a failing run of that row blocks the release once the row is part of the executed set. Hardware availability is tracked separately (see docs/production/driver-matrix.md).",
    "min_driver_basis": "Project baseline 2026-Q4. Values are engineering policy baselines, not vendor certifications. Review quarterly (docs/production/maintenance.md).",
    "driver_check": "run_matrix.py records a driver conformance verdict per host; only --require-min-driver turns 'below' into a hard failure.",
    "hosted_ci": {
      "gpu_available": false,
      "detail": "GitHub-hosted standard runners expose no usable GPU: Windows and Linux runners have no GPU device (software rasterizers such as WARP/llvmpipe can be used for non-visual tests) and macOS runners are virtualized machines where a discrete GPU / Metal device is not guaranteed. Hosted jobs may lint, validate the matrix and inspect artifacts, but they cannot replace the self-hosted GPU matrix."
    },
    "runner_convention": "Use self-hosted runners with the labels listed per row. Labels: self-hosted, <os>, <arch>, gpu-<vendor>, gpu-<kind>, and on Linux session-<x11|wayland>. Runners must be provisioned on persistent hardware with a connected display or dummy plug; nested virtualisation and GPU passthrough are not accepted."
  },
  "backends": {
    "opengl": {
      "display_name": "OpenGL",
      "min_api": "4.3",
      "goo_cli_flag": "--gpu-backend",
      "goo_cli_value": "opengl",
      "platforms": ["windows", "linux", "macos"],
      "status": {
        "windows": "required",
        "linux": "required",
        "macos": "advisory-deprecated"
      },
      "notes": "macOS caps OpenGL at 4.1 and Apple deprecated it; Goo on macOS is gated on Metal instead."
    },
    "vulkan": {
      "display_name": "Vulkan",
      "min_api": "1.2",
      "goo_cli_flag": "--gpu-backend",
      "goo_cli_value": "vulkan",
      "platforms": ["windows", "linux", "macos"],
      "status": {
        "windows": "required",
        "linux": "required",
        "macos": "unsupported"
      },
      "notes": "macOS has no native Vulkan; MoltenVK is not a production target for 5.2 and is intentionally not gated."
    },
    "metal": {
      "display_name": "Metal",
      "min_api": "Metal 3",
      "goo_cli_flag": "--gpu-backend",
